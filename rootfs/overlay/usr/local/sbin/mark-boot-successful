#!/bin/sh
set -eu

DEVINFO="/dev/disk/by-partlabel/devinfo"
PIXEL_DEVINFO="/usr/local/bin/pixel-devinfo"

echo "[boot-success] starting" > /dev/kmsg

if [ ! -e "$DEVINFO" ]; then
    echo "[boot-success] ERROR: devinfo partition not found" > /dev/kmsg
    exit 1
fi

echo "[boot-success] before update:" > /dev/kmsg
"$PIXEL_DEVINFO" "$DEVINFO" || true

"$PIXEL_DEVINFO" --successful true --unbootable false "$DEVINFO" "$DEVINFO"
sync

echo "[boot-success] after update:" > /dev/kmsg
"$PIXEL_DEVINFO" "$DEVINFO" || true

echo "[boot-success] done" > /dev/kmsg